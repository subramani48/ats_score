# ─────────────────────────────────────────────────────────────
#  ATS Analyzer Backend — Environment Variables
# ─────────────────────────────────────────────────────────────

# ── Database ────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/ats_analyzer"

# ── AI ──────────────────────────────────────────────────────
GEMINI_API_KEY="your-gemini-api-key"

# ── JWT ─────────────────────────────────────────────────────
# REQUIRED. Generate your own long random value (at least 16 characters, 32 or more recommended).
# The server refuses to start if this is missing, too short, or still this placeholder.
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# ── Email (SMTP) ─────────────────────────────────────────────
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your@gmail.com"
SMTP_PASS="your-app-password"

# ── App ─────────────────────────────────────────────────────
PORT=5000
FRONTEND_URL="http://localhost:3000"
NODE_ENV="development"

# ── File Upload ──────────────────────────────────────────────
MAX_FILE_SIZE_MB=5

# ── Telegram (optional) ──────────────────────────────────────
# When both are set, every uploaded resume is also forwarded to this Telegram chat. Leave empty to switch it off.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# ── OpenTelemetry (optional) ─────────────────────────────────
OTEL_ENABLED=false
OTEL_SERVICE_NAME="ats-analyzer-backend"
OTEL_EXPORTER_JAEGER_ENDPOINT="http://localhost:14268/api/traces"

# ── AI model and time limit (optional) ───────────────────────
# Model used by EVERY AI feature (older ones and Interview Pro). Default: gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash
# Longest wait for one AI call, in milliseconds (allowed 1000 to 300000). Default: 90000
GEMINI_TIMEOUT_MS=90000

# ── Hosting behind a proxy (Render) ──────────────────────────
# Number of proxies in front of the app, so rate limiting sees each visitor's real IP.
# 0 = none (local). On Render set this after verifying the right number (see project notes).
TRUST_PROXY_HOPS=0

# ── Seed script (local development only) ─────────────────────
# Optional: password for the demo accounts (at least 12 characters). If unset, a random one is
# generated and shown once when the accounts are created. The seed refuses to run when NODE_ENV is
# production, or when the database is not on this machine unless SEED_ALLOW_REMOTE=yes (set it on purpose only).
SEED_PASSWORD=
